{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polylane.local/contracts/evidence-dag-v3.schema.json",
  "title": "Polylane evidence DAG v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "graph_id", "policy_digest", "nodes", "claims"],
  "properties": {
    "schema_version": {"const": "evidence-dag/v3"},
    "graph_id": {"$ref": "#/$defs/stableId"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/node"}
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/claim"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stableId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "revision": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "output_digest"],
      "properties": {
        "node_id": {"$ref": "#/$defs/stableId"},
        "output_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "revision", "digest"],
      "properties": {
        "classification": {"enum": ["fixture", "public_corpus", "machine_only", "private_target_human", "released_artifact_human_ballot"]},
        "revision": {"$ref": "#/$defs/revision"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "node_type", "schema_version", "producer_id", "producer_revision", "inputs", "output_digest", "execution_digest", "source", "declared_grade", "revision_digest", "payload"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "node_type": {"$ref": "#/$defs/stableId"},
        "schema_version": {"type": "string", "pattern": "^[A-Za-z0-9._-]+/v[0-9]+$"},
        "producer_id": {"$ref": "#/$defs/stableId"},
        "producer_revision": {"type": "string", "pattern": "^[A-Za-z0-9._-]+/r[0-9]+$"},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/input"}},
        "output_digest": {"$ref": "#/$defs/digest"},
        "execution_digest": {"$ref": "#/$defs/digest"},
        "source": {"$ref": "#/$defs/source"},
        "declared_grade": {"enum": ["fixture", "diagnostic_public", "machine_only", "private_human_calibration", "released_artifact_human_ballot"]},
        "revision_digest": {"$ref": "#/$defs/digest"},
        "payload": {"type": "object"}
      }
    },
    "calibrationScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["population", "tasks", "domains", "states", "viewports", "criteria", "split", "acquisition_revision"],
      "properties": {
        "population": {"type": "string", "minLength": 1},
        "tasks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "domains": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "states": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "viewports": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "split": {"type": "string", "minLength": 1},
        "acquisition_revision": {"$ref": "#/$defs/digest"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject_node_id", "prerequisite_node_ids", "status", "claim_label", "human_calibrated", "human_certified", "taste_certified", "calibration_scope"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "subject_node_id": {"$ref": "#/$defs/stableId"},
        "prerequisite_node_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stableId"}},
        "status": {"enum": ["EVIDENCE-ONLY", "MACHINE-EVALUATED"]},
        "claim_label": {"enum": ["FIXTURE_ONLY", "DIAGNOSTIC_ONLY", "MACHINE_ONLY", "HUMAN_CALIBRATED_MACHINE"]},
        "human_calibrated": {"type": "boolean"},
        "human_certified": {"const": false},
        "taste_certified": {"const": false},
        "calibration_scope": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/calibrationScope"}]}
      }
    }
  }
}

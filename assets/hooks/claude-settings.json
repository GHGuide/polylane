{
  "_comment": "TEMPLATE — do not merge raw. Render with `<installed>/bin/polylane-hooks.sh render claude` to substitute __POLYLANE_HOOKS_HELPER__ with the absolute installed helper path plus its sha256, then merge the result into <project>/.claude/settings.json. Project-scoped; grants no permissions; never edits global settings or replaces the Polylane supervisor. If the helper is absent the guarded command is a silent no-op.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "h='__POLYLANE_HOOKS_HELPER__'; [ -x \"$h\" ] || exit 0; exec \"$h\" claude SessionStart --project \"$CLAUDE_PROJECT_DIR\"" }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          { "type": "command", "command": "h='__POLYLANE_HOOKS_HELPER__'; [ -x \"$h\" ] || exit 0; exec \"$h\" claude PreCompact --project \"$CLAUDE_PROJECT_DIR\"" }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          { "type": "command", "command": "h='__POLYLANE_HOOKS_HELPER__'; [ -x \"$h\" ] || exit 0; exec \"$h\" claude PostCompact --project \"$CLAUDE_PROJECT_DIR\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "h='__POLYLANE_HOOKS_HELPER__'; [ -x \"$h\" ] || exit 0; exec \"$h\" claude Stop --project \"$CLAUDE_PROJECT_DIR\"" }
        ]
      }
    ]
  }
}

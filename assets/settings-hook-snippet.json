{
  "_comment": "Merge into <project>/.claude/settings.json (create if absent, or merge each array into the existing one). This compatible replacement retains the non-blocking graph nudge and adds the optional project-scoped lifecycle helper. It restores only bounded context and checks current-run completion evidence; it grants no permissions and never replaces the supervisor. The user reviews this fragment rather than any installer mutating global configuration.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Glob",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/graphify-nudge.sh\"" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR/bin/polylane-hooks.sh\" claude SessionStart --project \"$CLAUDE_PROJECT_DIR\"" }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR/bin/polylane-hooks.sh\" claude PreCompact --project \"$CLAUDE_PROJECT_DIR\"" }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR/bin/polylane-hooks.sh\" claude PostCompact --project \"$CLAUDE_PROJECT_DIR\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR/bin/polylane-hooks.sh\" claude Stop --project \"$CLAUDE_PROJECT_DIR\"" }
        ]
      }
    ]
  }
}
